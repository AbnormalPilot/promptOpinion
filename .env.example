# Groq API Key (free at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# FHIR Server (default: public HAPI test server, no auth needed)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Server port
PORT=3000

# RAG service URL (for memory embeddings + CMS NCD lookup)
RAG_SERVICE_URL=http://localhost:3001

# HMAC salt for hashing patient IDs in audit logs. ROTATE PERIODICALLY.
AUDIT_SALT=replace-me-with-a-long-random-string

# Optional: disable audit log writing entirely
# AUDIT_DISABLED=1

# Optional: override paths for the self-learning data stores
# AUDIT_LOG_PATH=data/audit.jsonl
# MEMORY_PATH=data/memory.jsonl
# PATTERNS_PATH=data/patterns.json
# CALIBRATION_PATH=data/calibration.jsonl
